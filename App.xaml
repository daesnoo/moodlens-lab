<Application x:Class="TelegramMood.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <DrawingImage x:Key="AppIcon">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#0B6B60" Geometry="M3,6 C3,3.8 4.8,2 7,2 L25,2 C27.2,2 29,3.8 29,6 L29,18 C29,20.2 27.2,22 25,22 L16,22 L10,28 L10,22 L7,22 C4.8,22 3,20.2 3,18 Z">
                    <GeometryDrawing.Pen><Pen Brush="#7ED2B0" Thickness="1.2"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>
        <SolidColorBrush x:Key="InkBrush" Color="#18201F"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#63706D"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFDF8"/>
        <SolidColorBrush x:Key="CanvasBrush" Color="#F4F1E9"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0B6B60"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#075147"/>
        <SolidColorBrush x:Key="LineBrush" Color="#D8DED8"/>

        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Background" Value="{StaticResource CanvasBrush}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#FAF8F2"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#FAF8F2"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="MinHeight" Value="46"/><Setter Property="Padding" Value="22,10"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.86"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#E4EFEB"/><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Root" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#D3E6DE"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.82"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Application.Resources>
</Application>
