<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>MoodLensLab</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <None Update="data\moodlens-labeled-52.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Update="data\moodlens-surprise-labeled.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Update="data\moodlens-fear-labeled.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Update="data\moodlens-sadness-labeled.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Update="data\moodlens-sadness-round2.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Update="data\moodlens-fear-round2.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Update="data\moodlens-sadness-round3.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Update="data\moodlens-surprise-round2.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Update="data\moodlens-sadness-round4.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Update="data\moodlens-fear-round3.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Update="data\moodlens-anger-labeled.csv" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="tests\**\*.cs" />
    <None Remove="tests\**\*" />
  </ItemGroup>

</Project>
